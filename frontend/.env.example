# ─────────────────────────────────────────────────────────────
#  MAP — frontend/.env.example
#  Copy this to .env.local and fill in real values.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────
# For local development (client appends /api/v1 automatically):
VITE_API_URL=http://localhost:8000
# For production on Vercel — set this and leave VITE_API_URL unset:
# VITE_API_BASE_URL=https://your-app.onrender.com/api/v1
# Set to 'true' to use MSW mock handlers instead of the real backend
VITE_ENABLE_MSW=false
